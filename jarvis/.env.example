# === Cerveau (Claude) ===
# Clé API Anthropic (obligatoire à partir de la Phase 2).
ANTHROPIC_API_KEY=

# Modèle principal et modèle d'arrière-plan pour l'extraction de mémoire.
JARVIS_MODEL=claude-sonnet-4-5
JARVIS_MEMORY_MODEL=claude-haiku-4-5-20251001
JARVIS_MAX_TOKENS=1024

# === Langue / audio ===
JARVIS_LANGUAGE=fr
JARVIS_SAMPLE_RATE=16000

# === Wake word ===
JARVIS_WAKE_WORD=hey_jarvis
JARVIS_WAKE_THRESHOLD=0.5

# === STT (faster-whisper) ===
# device : auto | cpu | cuda        compute_type : auto | int8 | float16 | int8_float16
JARVIS_WHISPER_MODEL=medium
JARVIS_WHISPER_DEVICE=auto
JARVIS_WHISPER_COMPUTE_TYPE=auto

# === TTS ===
# provider : piper (local, offline) | elevenlabs (clé requise)
JARVIS_TTS_PROVIDER=piper
JARVIS_PIPER_VOICE=fr_FR-siwis-medium
JARVIS_ELEVENLABS_API_KEY=
JARVIS_ELEVENLABS_VOICE_ID=

# === Domotique (Home Assistant) ===
JARVIS_HOME_ASSISTANT_URL=
JARVIS_HOME_ASSISTANT_TOKEN=

# === Recherche web ===
JARVIS_TAVILY_API_KEY=

# === Sécurité / fichiers ===
# Racines autorisées pour les outils fichiers, séparées par ';'
# Exemple : C:\Users\moi\Documents;D:\Projets
JARVIS_ALLOWED_PATHS=
# Binaires autorisés pour run_command, séparés par ';'
# Exemple : git;python;notepad
JARVIS_COMMAND_ALLOWLIST=

# === Comportement ===
JARVIS_USER_NAME=Monsieur
# true => Jarvis vous appelle « Monsieur ».
JARVIS_ADDRESS_AS_MONSIEUR=false

# === Exécution ===
# true => les outils à effet de bord sont journalisés mais PAS exécutés.
JARVIS_DRY_RUN=false
JARVIS_DATA_DIR=data
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_DIR=logs
